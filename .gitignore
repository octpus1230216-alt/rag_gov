# =============================================================================
# rag-zh .gitignore
#
# 仓库策略：只托管「代码 + 配置模板 + 少量样例文档」
#   向量库 / 原文 / 模型权重 / 中间产物 一律不进仓库（100GB 级别）
#   唯一例外：samples/ 下的样例文档，用于 CI 与新人跑通端到端流程
#
# Git 规则提醒：negation（!）无法「救回」位于已忽略目录内的文件，
# 所以下面所有 ! 规则都针对未被整体忽略的目录（samples/）。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 数据与索引产物（体积大 / 可再生 / 含敏感原文）
# -----------------------------------------------------------------------------
data/
storage/
models/
parsed/
chunks/
vectors/
logs/

# parquet 中间导出（ingestion 阶段的分片产物）
*.parquet

# SQLite：精确索引（FTS5）+ 模糊 n-gram 倒排 + 元数据库
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite-journal
*.wal
*.shm

# 向量库二进制段文件（防止误放进其他目录）
*qdrant*/
snapshots/

# -----------------------------------------------------------------------------
# 2. 配置与密钥（settings.yaml 由 settings.example.yaml 复制生成，含真实连接串）
# -----------------------------------------------------------------------------
config/settings.yaml
config/local.*.yaml
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# -----------------------------------------------------------------------------
# 3. 运行期缓存
# -----------------------------------------------------------------------------
jieba.cache
.paddleocr/
.cache/
.cache/huggingface/
huggingface/
wandb/
*.log
tmp/
temp/

# -----------------------------------------------------------------------------
# 4. Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/

# 测试与静态检查
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.coverage
.coverage.*
htmlcov/
coverage.xml

# IDE / 系统
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Jupyter（本项目不用，防止临时实验文件混入）
.ipynb_checkpoints/
*.ipynb

# -----------------------------------------------------------------------------
# 5. 大文件：原始文档一律不进仓库
#    注意顺序——后写的 ! 规则覆盖前面的 * 规则
# -----------------------------------------------------------------------------
*.pdf
*.docx
*.pptx
*.xlsx
*.xls
*.ppt
*.doc
# 扫描版 PDF 常见的伴生图片格式（OCR 中间产物）
*.tif
*.tiff
*.bmp

# 例外：显式包含 samples/ 下的样例文档（用于 pytest 端到端与 README 演示）
!samples/
!samples/*.pdf
!samples/*.docx
!samples/*.pptx
!samples/*.xlsx
!samples/**/*.pdf
!samples/**/*.docx
!samples/**/*.pptx
!samples/**/*.xlsx

# -----------------------------------------------------------------------------
# 6. 分批开发遗留的临时目录（非交付物，不进仓库）
#    保留根目录的 _check_batch*.py 回归自检脚本（属于交付的一部分）
# -----------------------------------------------------------------------------
_tmp_batch*/
_ignore_check/
_scratch/
